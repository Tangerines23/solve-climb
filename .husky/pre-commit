#!/bin/sh

set -e

echo "🔍 초고속 프리커밋 검증 시작..."

# 1. 병렬 정적 분석 및 핵심 도메인 불변식/퍼징 검증
if ! node scripts/fast-pre-commit.js; then
  echo ""
  echo "❌ 사전 검증 실패"
  echo "💡 위의 실패 항목을 확인하고 수정한 후 다시 커밋해주세요."
  exit 1
fi

# 2. lint-staged 실행 (변경된 파일만 ESLint + Prettier 자동 포맷팅)
echo "📝 lint-staged 실행 (변경된 파일 서식 및 린트)..."
if ! npx lint-staged 2>&1; then
  echo ""
  echo "❌ lint-staged 검증 실패"
  echo "💡 ESLint 또는 Prettier 에러를 확인해주세요."
  exit 1
fi

# 3. DB 마이그레이션 변경 감지 (조건부)
DB_CHANGED=$(node scripts/check-db-changes.js 2>/dev/null || echo "")
if [ -n "$DB_CHANGED" ]; then
  echo "🗄️ $DB_CHANGED - DB 스키마 검증 실행..."
  if ! npm run check:db 2>&1; then
    echo ""
    echo "❌ DB 검증 실패"
    echo "💡 DB 마이그레이션 또는 스키마에 문제가 있습니다."
    exit 1
  fi
fi

# 4. 환경 정리
echo "🧹 환경 정리..."
npm run report:collect >/dev/null 2>&1 || true

echo ""
echo "✅ 모든 커밋 검증 통과!"
