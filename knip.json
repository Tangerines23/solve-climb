{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "vitest": false,
  "playwright": false,
  "entry": ["src/main.tsx", "src/utils/tossAuth.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/types/**",
    "src/hooks/useRoadmapLayout.ts",
    "src/components/roadmap/LinearLandmarkItem.tsx",
    "src/components/roadmap/NonLinearTierItem.tsx"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "files": "warn",
    "devDependencies": "warn"
  },
  "ignoreDependencies": [
    "@stryker-mutator/typescript-checker",
    "@storybook/react",
    "@types/js-yaml",
    "playwright"
  ],
  "ignoreBinaries": ["ait"]
}
